<!DOCTYPE html>
<html lang="EN">
	<head>
		{{ template "common_meta" . }}
	</head>
	
	<body>
		{{ template "common_heading_start" }}
		{{ template "common_heading_end" }}
		<h2>Search{{ if .Search }} results for "{{ .Search }}"{{ end }}</h2>
		<table>
			<thead>
				<tr>
					<th>Date</th>
					<th>Device</th>
					<th>Port</th>
					<th>CDP</th>
					<th>IP</th>
					<th>Host</th>
				</tr>
			</thead>
			<tbody>
				{{ range .Row }}
				<tr>
					<td>{{ .Date }}</td>
					<td><a href="/campus/switches/ports/?switch={{ .Switch }}">{{ .Switch }}</a></td>
					<td>{{ .Port }}</td>
					<td>{{ .CDP }}</td>
					<td>{{ .IP }}</td>
					<td>{{ .Host }}</td>
				</tr>
				{{ end }}
			</tbody>
		</table>
		{{ template "common_footer" . }}
	</body>
</html>
